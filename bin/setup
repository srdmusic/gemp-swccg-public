#!/bin/bash

################################################################################
# GEMP-SWCCG Setup Script
#
# This script automates the complete setup of the GEMP-SWCCG development
# environment.
#
# Requirements: Docker Desktop must be installed and running
#
# Usage: ./setup.sh
################################################################################

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}==>${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_header() {
    echo ""
    echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}$1${NC}"
    echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
    echo ""
}

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to wait for user confirmation
confirm() {
    read -p "$1 [y/N] " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]]
}

################################################################################
# Pre-flight checks
################################################################################

print_header "GEMP-SWCCG Setup - Pre-flight Checks"

# Check if Docker is installed
if ! command_exists docker; then
    print_error "Docker is not installed!"
    echo "Please install Docker Desktop from https://www.docker.com/products/docker-desktop/"
    exit 1
fi
print_success "Docker is installed"

# Check if Docker is running
if ! docker info >/dev/null 2>&1; then
    print_error "Docker is not running!"
    echo "Please start Docker Desktop and try again."
    exit 1
fi
print_success "Docker is running"

# Check if docker compose is available
if ! docker compose version >/dev/null 2>&1; then
    print_error "Docker Compose is not available!"
    echo "Please ensure Docker Desktop includes Docker Compose v2"
    exit 1
fi
print_success "Docker Compose is available"

# Detect platform
PLATFORM=$(uname -s)
print_status "Detected platform: $PLATFORM"

if [ "$PLATFORM" = "Darwin" ]; then
    MACOS_VERSION=$(sw_vers -productVersion)
    print_status "macOS version: $MACOS_VERSION"
fi

# Get script directory and project root
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$( cd "$SCRIPT_DIR/.." && pwd )"

print_success "Project root: $PROJECT_ROOT"

################################################################################
# Step 1: Create required directories and files
################################################################################

print_header "Step 1: Creating Required Directories"

print_status "Creating logs directory..."
mkdir -p "$PROJECT_ROOT/logs"
print_success "Created: $PROJECT_ROOT/logs"

print_status "Creating nohup.out file..."
touch "$PROJECT_ROOT/logs/nohup.out"
print_success "Created: $PROJECT_ROOT/logs/nohup.out"

print_status "Creating database directory..."
mkdir -p "$PROJECT_ROOT/database"
print_success "Created: $PROJECT_ROOT/database"

print_status "Creating replays directory..."
mkdir -p "$PROJECT_ROOT/replays"
print_success "Created: $PROJECT_ROOT/replays"

################################################################################
# Step 2: Prepare docker-compose.yml
################################################################################

print_header "Step 2: Preparing Docker Configuration"

cd "$PROJECT_ROOT/src"

# Check if docker-compose.yml exists
if [ ! -f "docker-compose.yml" ]; then
    print_error "docker-compose.yml not found in src/ directory!"
    exit 1
fi

# Backup the original docker-compose.yml
print_status "Creating backup of docker-compose.yml..."
cp docker-compose.yml docker-compose.yml.backup
print_success "Backup created: docker-compose.yml.backup"

# Comment out the command section (lines 42-48) if not already commented
print_status "Commenting out command section for initial build..."
sed -i.tmp '42,48s/^[[:space:]]*\([^#]\)/#\1/' docker-compose.yml
rm -f docker-compose.yml.tmp
print_success "Command section commented out"

################################################################################
# Step 3: Stop any existing containers
################################################################################

print_header "Step 3: Cleaning Up Existing Containers"

if docker ps -a --filter "name=gemp_swccg" --format "{{.Names}}" | grep -q gemp_swccg; then
    print_warning "Found existing GEMP containers. Removing them..."
    docker compose down 2>/dev/null || true
    print_success "Existing containers removed"
else
    print_status "No existing containers found"
fi

################################################################################
# Step 4: Build Docker images
################################################################################

print_header "Step 4: Building Docker Images"

print_status "This may take several minutes on first build..."
echo ""

if docker compose build; then
    print_success "Docker images built successfully"
else
    print_error "Failed to build Docker images"
    exit 1
fi

################################################################################
# Step 5: Start containers
################################################################################

print_header "Step 5: Starting Docker Containers"

print_status "Starting database and application containers..."
if docker compose up -d; then
    print_success "Containers started"
else
    print_error "Failed to start containers"
    exit 1
fi

# Wait for containers to be ready
print_status "Waiting for containers to initialize..."
sleep 5

# Verify containers are running
if docker ps --filter "name=gemp_swccg_app_1" --format "{{.Names}}" | grep -q gemp_swccg_app_1; then
    print_success "Application container is running"
else
    print_error "Application container failed to start"
    exit 1
fi

if docker ps --filter "name=gemp_swccg_db_1" --format "{{.Names}}" | grep -q gemp_swccg_db_1; then
    print_success "Database container is running"
else
    print_error "Database container failed to start"
    exit 1
fi

################################################################################
# Step 6: Compile application with Maven
################################################################################

print_header "Step 6: Compiling Application with Maven"

print_status "This will take 5-10 minutes on first build..."
print_status "Downloading dependencies and compiling all modules..."
echo ""

if docker exec gemp_swccg_app_1 mvn install; then
    print_success "Application compiled successfully"
else
    print_error "Maven build failed"
    exit 1
fi

# Verify web.jar was created
if docker exec gemp_swccg_app_1 test -f /opt/gemp-swccg/src/gemp-swccg-async/target/web.jar; then
    print_success "web.jar created successfully"
else
    print_error "web.jar was not created"
    exit 1
fi

################################################################################
# Step 7: Update docker-compose.yml to enable application startup
################################################################################

print_header "Step 7: Enabling Application Startup"

print_status "Uncommenting command section in docker-compose.yml..."
# Restore the original file and ensure command section is uncommented
cp docker-compose.yml.backup docker-compose.yml
print_success "Command section enabled"

################################################################################
# Step 8: Restart containers and start application
################################################################################

print_header "Step 8: Starting GEMP Application"

print_status "Restarting containers..."
docker compose restart
sleep 3

print_status "Starting Java application manually..."
docker exec -d gemp_swccg_app_1 sh -c "nohup java -Xmx4g -Dlog4j.debug -Dlog4j.configurationFile=/opt/gemp-swccg/src/gemp-swccg-async/src/main/resources/prod-log4j.xml -jar /opt/gemp-swccg/src/gemp-swccg-async/target/web.jar com.gempukku.swccgo.async.SwccgoAsyncServer > /logs/nohup.out 2>&1 &"

print_status "Waiting for application to start..."
sleep 10

# Verify Java process is running
if docker exec gemp_swccg_app_1 ps aux | grep -q "java.*web.jar"; then
    print_success "Java application is running"
else
    print_warning "Java process may not have started correctly"
fi

################################################################################
# Step 9: Verify application is accessible
################################################################################

print_header "Step 9: Verifying Application"

print_status "Testing HTTP connection to application..."
sleep 5  # Give it a bit more time

HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:17001/gemp-swccg/ 2>&1 || echo "000")

if [ "$HTTP_CODE" = "200" ]; then
    print_success "Application is accessible at http://localhost:17001/gemp-swccg/"
else
    print_warning "HTTP response code: $HTTP_CODE"
    print_warning "Application may still be starting up..."
    print_status "Checking application logs..."
    echo ""
    tail -20 "$PROJECT_ROOT/logs/nohup.out"
    echo ""
    print_warning "If you see 'GempukkuServer startup complete.' above, the app should be ready soon"
fi

################################################################################
# Summary
################################################################################

print_header "Setup Complete!"

echo -e "${GREEN}Your GEMP-SWCCG development environment is ready!${NC}"
echo ""
echo "Application URL:  ${BLUE}http://localhost:17001/gemp-swccg/${NC}"
echo "Default Login:    ${BLUE}asdf / asdf${NC}"
echo ""
echo "Database Access:"
echo "  Host:           ${BLUE}localhost:35001${NC}"
echo "  Database:       ${BLUE}gemp-swccg${NC}"
echo "  User/Password:  ${BLUE}gemp / Four_mason8pirate${NC}"
echo ""
echo "Useful Commands:"
echo "  View logs:      ${BLUE}tail -f logs/nohup.out${NC}"
echo "  Stop:           ${BLUE}cd src && docker compose down${NC}"
echo "  Start:          ${BLUE}cd src && docker compose up -d${NC}"
echo "  Rebuild:        ${BLUE}docker exec gemp_swccg_app_1 mvn install${NC}"
echo ""
echo "Documentation:"
echo "  Setup Issues:   ${BLUE}ai_context/initial_setup_issues.md${NC}"
echo "  Development:    ${BLUE}CLAUDE.md${NC}"
echo "  Docker Details: ${BLUE}src/docker/readme.md${NC}"
echo ""

if [ "$HTTP_CODE" != "200" ]; then
    print_warning "Note: Application may still be starting up. Wait 30 seconds and try accessing the URL."
    echo "Check logs with: tail -f logs/nohup.out"
fi

print_success "Setup script completed successfully!"
echo ""
